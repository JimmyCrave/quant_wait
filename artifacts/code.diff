diff --git a/penalty/build_qwen_marker_ids.py b/penalty/build_qwen_marker_ids.py
new file mode 100644
index 0000000..2ae6ce0
--- /dev/null
+++ b/penalty/build_qwen_marker_ids.py
@@ -0,0 +1,27 @@
+"""Map the 50 overthinking markers of paper Appendix C (Table 8) to token IDs of the
+DeepSeek-R1-Distill-Qwen tokenizer. Every marker carries a leading space ("_" in the paper)
+and must encode to exactly ONE token; otherwise it is reported and excluded (never guessed)."""
+import json
+import sys
+
+from transformers import AutoTokenizer
+
+MARKERS = ("perhaps maybe wait Wait actually hold Hmm hmm Alternatively alternatively However however "
+           "instead Instead But but though although yet rather unless otherwise nonetheless nevertheless "
+           "regardless still anyway Or or either whether uncertain unsure possibly might could another "
+           "different reconsider rethink backtrack retry recheck revisit doubt confused wrong mistake "
+           "error incorrect").split()
+assert len(MARKERS) == 50 and len(set(MARKERS)) == 50
+
+model, out = sys.argv[1], sys.argv[2]
+tok = AutoTokenizer.from_pretrained(model)
+mapping, missing = {}, {}
+for m in MARKERS:
+    ids = tok.encode(" " + m, add_special_tokens=False)
+    if len(ids) == 1 and tok.decode(ids) == " " + m:
+        mapping[" " + m] = ids[0]
+    else:
+        missing[" " + m] = {"ids": ids, "pieces": tok.convert_ids_to_tokens(ids)}
+json.dump({"tokenizer": model, "n_paper_markers": len(MARKERS), "n_single_token": len(mapping),
+           "token_ids": mapping, "not_single_token": missing}, open(out, "w"), indent=1)
+print(len(mapping), "single-token markers;", "multi-token:", missing)
diff --git a/penalty/marker_penalty.py b/penalty/marker_penalty.py
new file mode 100644
index 0000000..4c939e5
--- /dev/null
+++ b/penalty/marker_penalty.py
@@ -0,0 +1,33 @@
+"""Marker penalty as a per-request vLLM logits processor (no vLLM patch).
+
+z'(v) = z(v) - lambda  for v in marker token set, unchanged otherwise (paper Eq. 1).
+
+Order in vLLM 0.7.0 (V0 engine, third-party/vllm):
+  LogitsProcessor.forward -> _apply_logits_processors (this class; RAW model logits)  [logits_processor.py:80]
+  Sampler.forward         -> temperature division [sampler.py:271] -> top-p/top-k [sampler.py:274]
+                             -> softmax -> sampling
+i.e. the penalty is applied to raw (pre-temperature) logits, before temperature and top-p.
+Note: raw logits are in the model dtype (bf16), so the subtraction is rounded to bf16 resolution.
+"""
+import json
+
+import torch
+
+
+def load_marker_token_ids(path):
+    with open(path) as f:
+        return sorted(set(json.load(f)["token_ids"].values()))
+
+
+class MarkerPenaltyProcessor:
+    def __init__(self, token_ids, penalty):
+        self.token_ids = list(token_ids)
+        self.penalty = float(penalty)
+        self._idx = {}
+
+    def __call__(self, past_token_ids, logits):
+        idx = self._idx.get(logits.device)
+        if idx is None:
+            idx = self._idx[logits.device] = torch.tensor(self.token_ids, dtype=torch.long, device=logits.device)
+        logits[idx] -= self.penalty
+        return logits
